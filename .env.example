# --- Base de données (docker compose up -d) -------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/anach_car?schema=public"

# --- Authentification -----------------------------------------------------
AUTH_SECRET="CHANGEZ-MOI-openssl rand -base64 32"
SESSION_MAX_AGE_DAYS="7"

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.anachcar.ma"

# --- Stockage des fichiers (local | vercel-blob) --------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
BLOB_READ_WRITE_TOKEN=""

# --- Emails transactionnels (console | resend) ----------------------------
EMAIL_DRIVER="console"
EMAIL_FROM="Anach Car <reservations@anachcar.ma>"
EMAIL_AGENCY_INBOX="anachcar64@gmail.com"
RESEND_API_KEY=""

# --- Tâches planifiées (rappels clients) ----------------------------------
# Généré avec : openssl rand -hex 32
CRON_SECRET=""
